# Server Configuration
PORT=3000

# ==============================================================================
# Supabase Configuration
# ==============================================================================
# SUPABASE_URL:
# Publicly accessible endpoint of your Supabase project. Safe for frontend and server.
SUPABASE_URL=https://your-project-id.supabase.co

# SUPABASE_ANON_KEY:
# Safe to expose to the frontend. Used by Supabase client to authenticate users
# and enforce Row Level Security (RLS) policies.
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# SUPABASE_SERVICE_ROLE_KEY:
# CRITICAL SECURITY NOTE:
# This key MUST REMAIN SERVER-SIDE ONLY. NEVER expose this key in public/ or frontend JS.
# It bypasses Row Level Security and has full admin access to your database.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
